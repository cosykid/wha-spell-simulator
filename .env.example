# Copy to .env for local development: `cp .env.example .env`
#
# The app and the migration runner both read DATABASE_URL_VPS.
#
# Local default: the throwaway Postgres from docker-compose.dev.yml. No sslmode
# (TLS off) is correct for a local, trusted connection. Works out of the box once
# `docker compose -f docker-compose.dev.yml up -d` is running.
DATABASE_URL_VPS="postgres://wha:wha@localhost:5432/wha"

# Remote (production / preview): point at pgbouncer with TLS instead, e.g.
# DATABASE_URL_VPS="postgresql://wha:password@db.yourdomain.com:6432/wha?sslmode=verify-full"
