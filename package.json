{
	"name": "witch-hat-atelier-spell-simulator",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --host --port 5173",
		"start": "npm run dev",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 4173",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"db:migrate": "node --import tsx scripts/migrate.ts",
		"glyphs:reference-sizes": "node --import tsx models/glyph-reference-sizes.ts",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "node --import tsx --test tests/*.test.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright install && playwright test",
		"normalize:svg": "node scripts/normalize-svgs.mjs src/lib/dictionary/svg --stroke-width 0.4",
		"sample:svg": "node --import tsx models/sample-to-svg.ts",
		"train:glyphs": "bash models/training/run_glyph_training.sh",
		"postinstall": "node models/sync-onnxruntime-assets.mjs",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.8.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/node": "^24.13.1",
		"@types/pg": "^8.11.10",
		"@zerodevx/svelte-toast": "^0.9.6",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.1.0",
		"svelte-check": "^4.6.0",
		"svgpath": "^2.6.0",
		"tsx": "^4.22.4",
		"typescript": "^5.5.0",
		"typescript-eslint": "^8.58.1",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"kysely": "^0.29.2",
		"lucide-svelte": "^1.0.1",
		"onnxruntime-web": "^1.26.0",
		"pg": "^8.13.0",
		"zod": "^4.4.3"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	}
}
